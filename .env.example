# Tixora Backend Environment Variables (.env)

# Database (PostgreSQL - Render auto-provisions or use ElephantSQL/Neon)
DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Or individual:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=tixora
# DB_USER=postgres
# DB_PASSWORD=pass

# JWT (generate secure random)
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars

# Paystack (dashboard.paystack.com test keys)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx  # Optional for webhooks

# Email (Gmail App Password: myaccount.google.com/apppasswords)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASS=your16charapppassword
EMAIL_FROMNAME="TIXORA"

# Server (Render auto-sets)
PORT=10000
